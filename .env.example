# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:3000

# Recurring Event Limits
MAX_RECURRING_INSTANCES=365
MAX_RECURRING_YEARS=2

# Vercel Cron Secret (optional, for securing the cron endpoint)
CRON_SECRET=

# Activation support/review admin (comma-separated verified account emails)
CALCONNECT_ADMIN_EMAILS=

# Lifecycle email delivery: disabled by default; every message also needs review approval.
# Daily cron is installed but does nothing while disabled. Review docs/activation-release.md before enabling.
LIFECYCLE_EMAIL_ENABLED=false
LIFECYCLE_EMAIL_FROM=
LIFECYCLE_REPLY_TO=n.christensen4@gmail.com
LIFECYCLE_POSTAL_ADDRESS=
LIFECYCLE_UNSUBSCRIBE_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Dedicated quantity-only extra-calendar portal; never use the base-plan portal.
STRIPE_ADDON_PORTAL_CONFIGURATION_ID=

# Automatic queueing only runs when delivery is also enabled and postal address is set.
LIFECYCLE_AUTOMATION_ENABLED=false
