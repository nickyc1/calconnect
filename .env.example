# Pipedream Connect Configuration
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development

# Supabase Configuration
# NEXT_PUBLIC_ prefix makes these available to client-side code
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-side only (no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Webhook Configuration
# Set to your ngrok URL during local development (e.g., https://abc123.ngrok-free.dev)
WEBHOOK_BASE_URL=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ...